# Copia este archivo a .env.local para trabajar en local.
# En Cloud Agents, define los mismos nombres como Secrets en
# https://cursor.com/dashboard/cloud-agents
# No subas valores reales al repositorio.

# URL pública del proyecto (supabase/config.toml → project_id).
SUPABASE_URL=https://pwzqriypryqxzuczhrpp.supabase.co
VITE_SUPABASE_URL=https://pwzqriypryqxzuczhrpp.supabase.co

# Clave publicable (anon o sb_publishable_). Puede ir en el cliente.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clave de servicio. Solo en el servidor. Nunca en el cliente ni en git.
SUPABASE_SERVICE_ROLE_KEY=
